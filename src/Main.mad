import IO from "IO"
import List from "List"
import Maybe from "Maybe"
import Wish from "Wish"

import SafeSpace from "@/SafeSpace"



printOutput = (k) => Wish.fulfill(
  pipe(
    IO.pTrace("bad path"),
    (_) => {},
  ),
  pipe(
    IO.pTrace(k),
    (_) => {},
  ),
)
getCWD = pipe(
  List.drop(1),
  List.first,
  Maybe.fromMaybe("./"),
)
main = (args) => {
  cwd = getCWD(args)
  pipe(
    SafeSpace.check,
    printOutput("check"),
  )(cwd)
  pipe(
    SafeSpace.getUncommitted,
    printOutput("uncommitted"),
  )(cwd)
  pipe(
    SafeSpace.getUnstaged,
    printOutput("unstaged"),
  )(cwd)
}
